# ===== SERVER =====
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ===== SECURITY =====
# Generate strong random strings for these, e.g. `openssl rand -hex 32`
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=replace_this_with_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# ===== DATABASE =====
DATABASE_PATH=./data/autumn_gents_suites.db

# ===== SITE / OWNER EMAIL (site's own inbox) =====
# Create this mailbox with a real provider first (Zoho Mail free plan or
# Google Workspace both let you use a custom domain, e.g. info@autumngentssuites.com)
# then paste the SMTP credentials it gives you here.
SITE_EMAIL_ADDRESS=info@autumngentssuites.com
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@autumngentssuites.com
SMTP_PASS=replace_with_real_app_password

# ===== DEFAULT ADMIN / TECH ACCOUNTS =====
ADMIN_NAME=Site Administrator
ADMIN_EMAIL=admin@autumngentssuites.com
ADMIN_PASSWORD=ChangeMe_Admin123!
TECH_NAME=IT Technician
TECH_EMAIL=tech@autumngentssuites.com
TECH_PASSWORD=ChangeMe_Tech123!

# ===== DEVELOPER CONTACT EMAIL =====
DEVELOPER_EMAIL=dev@autumngentssuites.com

# ===== PAYMENTS (Stripe) =====
# Sign up at https://dashboard.stripe.com, grab keys from Developers > API keys
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
CURRENCY=kes

# ===== FILE UPLOADS =====
MAX_UPLOAD_MB=8
